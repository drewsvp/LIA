modules = ["python-3.12", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["chromium"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
EMAIL_FROM_ADDRESS = "info@defendingthecause.org"
EMAIL_FROM_NAME = "The Alliance"
STAFF_NOTIFY_PRIMARY = "tiffany@defendingthecause.org"
STAFF_NOTIFY_SECONDARY = "christina@defendingthecause.org"

[userenv.production]
APP_BASE_URL = "https://lia.defendingthecause.org"
QUICK_LOGIN_ENABLED = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-quick-login"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "responsive-nav"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "test-quick-login"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development npx tsx scripts/test-quick-login.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "responsive-nav"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:responsive-nav"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-78fe5153-2524-4ba6-b9a4-13ff9d3bb310"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["bash", "-c", "npm run db:apply-migrations && npm run build"]
